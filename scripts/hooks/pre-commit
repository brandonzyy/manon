#!/bin/bash
# manon 的本机执行器 —— 提交前跑秒级那一档（skills 不变量 + L1 五条棘轮）。
#
# **这份是源，装到 .git/hooks/ 的是副本**（scripts/install-hooks.py）。
# 钩子不入库的后果是它活不过一次重新克隆，而「没装」和「装了」在事后看长得一样。
#
# 全局 core.hooksPath 会让 .git/hooks 被忽略，但 ~/.config/git/hooks/_chain.sh
# 会把仓内同名钩子原样接力回来，所以这个文件是生效的。
# 体检：cd ~/manon && .git/hooks/pre-commit —— 看得到判据输出才算装上。
#
# ## 为什么必须用独立的 L1 venv
#
# CI 刻意在**装产品依赖之前**跑 L1（ci.yml：「此刻环境里不许有产品依赖」）。
# 用项目 .venv 跑同一条判据，mypy 会因为多出来的那些包换一套解析结果——
# 实测多报 6 条 import-untyped，而 CI 上一条都没有。
# 一道红在环境差异上的门禁会被 --no-verify 绕过，连带它真正拦得住的那些一起。
#
# 这个 venv 放在**仓外**（~/.cache）。放仓内的话 vulture 会把 site-packages
# 当成源码扫进去——实测一次就多出 40 多条 unused import。
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
VENV="${MANON_L1_VENV:-$HOME/.cache/manon-l1-venv}"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "❌ L1 工具链不在 ${VENV}。装一次：python3 scripts/install-hooks.py" >&2
  echo "   本门禁刻意不跳过——工具缺失时静默放行，等于谎报「有人看着」。" >&2
  exit 1
fi

cd "$ROOT"
export PATH="$VENV/bin:$PATH"
"$VENV/bin/python" scripts/check_skills.py
# **deps 不进提交路径**：pip-audit 要连 OSV，实测把这道钩子从 1.4 秒拖到 17 秒，
# 超出「提交钩子 ≤15 秒」的预算。慢门禁的下场是被 --no-verify 绕过，连带
# 其余四条一起。它的执行器在 CI（ci.yml 的 l1-and-tests），那里本来就联网。
"$VENV/bin/python" scripts/check_l1.py lint typing dead contract
