# Manon Configuration Example
# Copy this file to .env and fill in your values

# ── API Configuration ──────────────────────────────────
# Manon API URL
# Default: official SaaS service (auto geo-routed)
# For self-hosted: set to http://localhost:3700
# MANON_API_URL=http://localhost:3700

# Manon API Key (auto-generated on first use, or get from official service)
MANON_API_KEY=msk_your_api_key_here

# ── SaaS Server Configuration ──────────────────────────
# Server port
SAAS_PORT=3700

# Database path
SAAS_DB_PATH=./saas.db

# Repository storage directory
SAAS_REPOS_DIR=./saas_repos

# Index storage directory
SAAS_INDEX_DIR=./saas_indexes

# Training data directory
SAAS_DATA_DIR=./saas_data

# ── Embedding Service Configuration ────────────────────
# Embedding service URL (OpenAI-compatible endpoint)
# Options:
#   - GLM: https://open.bigmodel.cn/api/paas/v4 (recommended)
#   - OpenAI: https://api.openai.com/v1
#   - TEI (legacy): http://localhost:3002 (leave SAAS_EMBEDDING_MODEL empty)
SAAS_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4

# Embedding model name (leave empty for legacy TEI mode)
SAAS_EMBEDDING_MODEL=embedding-3

# Embedding API key (required for GLM/OpenAI)
SAAS_EMBEDDING_API_KEY=

# ── LLM Configuration ──────────────────────────────────
# LLM API URL (OpenAI-compatible endpoint)
# Examples:
#   - GLM: https://open.bigmodel.cn/api/paas/v4/chat/completions
#   - Ollama: http://localhost:11434/v1/chat/completions
#   - OpenAI: https://api.openai.com/v1/chat/completions
SAAS_LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# LLM model name
SAAS_LLM_MODEL=glm-4.5-air

# LLM API key (required for GLM/OpenAI, leave empty for Ollama)
SAAS_LLM_API_KEY=

# ── Admin Configuration ────────────────────────────────
# Admin secret for privileged operations
SAAS_ADMIN_SECRET=your_admin_secret_here

# ── Rate Limits (requests per minute) ──────────────────
SAAS_RATE_FREE=30
SAAS_RATE_PRO=300
SAAS_RATE_ENTERPRISE=3000

# ── Quotas ─────────────────────────────────────────────
# Repository quotas per tier
SAAS_QUOTA_REPOS_FREE=2
SAAS_QUOTA_REPOS_PRO=20
SAAS_QUOTA_REPOS_ENTERPRISE=9999

# Deep query quotas per day
SAAS_QUOTA_DEEP_QUERY_FREE=10
SAAS_QUOTA_DEEP_QUERY_PRO=9999
SAAS_QUOTA_DEEP_QUERY_ENTERPRISE=9999
